# App Settings
APP_NAME="Space Sentiment Index"
DEBUG=True
DATABASE_URL="sqlite:///./data/space_sentiment.db"
TIMEZONE="America/Argentina/Cordoba"

# Data Providers
X_PROVIDER="twikit"  # Options: "twikit", "mock" or "off" (X switched off on purpose, no SOURCE_ERROR alert)
X_AUTH_INFO_1=""
X_AUTH_INFO_2=""
X_PASSWORD=""
X_AUTH_TOKEN=""
X_CT0=""
X_COOKIES_FILE="data/x_cookies.json"

POLYMARKET_PROVIDER="polymarket"  # Options: "mock" or "polymarket"
NEWS_PROVIDER="rss"               # Options: "mock" or "rss"
# SEC EDGAR dilution monitor (FILING alerts, SEC OFFERING modifier and gate). The SEC requires a User-Agent with your name and a contact
# email; the collector stays disabled while it is empty.
SEC_PROVIDER="edgar"              # Options: "mock" or "edgar"
SEC_USER_AGENT=""                 # e.g. "SMIE research your-name your-email@example.com"
ALLOW_MOCK_FALLBACK=False         # Set False to avoid generating synthetic fallback data

# An SEC offering prospectus (424B) in the last SEC_FILING_ALERT_DAYS caps BUY at WATCH (since rules 2.2.5)
SEC_OFFERING_GATE_ENABLED=True

# Shadow social source: Adanos free X sentiment API (250 requests/month, non-commercial). Stored in
# social_shadow_daily and measured only; it never feeds the SMI. Get a free key at https://adanos.com/register
ADANOS_SHADOW_ENABLED=False
ADANOS_API_KEY=""

# Sentiment Analysis Settings (100% Local Inference, No API Keys Required)
SENTIMENT_MODEL="ProsusAI/finbert" # HuggingFace financial model cached locally in ~/.cache/huggingface/
USE_FINBERT=True                   # Set True for local FinBERT neural classification, False for heuristic dictionary
SOCIAL_SENTIMENT_MODEL="StephanAkkerman/FinTwitBERT-sentiment"  # X/Twitter model (local, MIT); "ProsusAI/finbert" to revert
SOCIAL_SENTIMENT_THRESHOLD=0.90    # |P(bull)-P(bear)| needed to count a tweet as an opinion (0.20 for FinBERT)

# Scheduler
ENABLE_SCHEDULER=False
JOB_INTERVAL_MINUTES=60
