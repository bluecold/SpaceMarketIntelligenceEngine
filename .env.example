# App Settings
APP_NAME="Space Sentiment Index"
DEBUG=True
DATABASE_URL="sqlite:///./data/space_sentiment.db"
TIMEZONE="America/Argentina/Cordoba"

# Data Providers
X_PROVIDER="mock"  # Options: "mock" or "twikit"
X_AUTH_INFO_1=""
X_AUTH_INFO_2=""
X_PASSWORD=""
X_COOKIES_FILE="data/x_cookies.json"

# Sentiment Analysis Settings
SENTIMENT_MODEL="ProsusAI/finbert" # or "heuristic"
USE_FINBERT=False # Set to True to load FinBERT local model (requires torch/transformers)

# Scheduler
ENABLE_SCHEDULER=False
JOB_INTERVAL_MINUTES=60
