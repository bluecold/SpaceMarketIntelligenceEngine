# App Settings
APP_NAME="Space Sentiment Index"
DEBUG=True
DATABASE_URL="sqlite:///./data/space_sentiment.db"
TIMEZONE="America/Argentina/Cordoba"

# Data Providers
X_PROVIDER="twikit"  # Options: "mock" or "twikit"
X_AUTH_INFO_1=""
X_AUTH_INFO_2=""
X_PASSWORD=""
X_AUTH_TOKEN=""
X_CT0=""
X_COOKIES_FILE="data/x_cookies.json"

POLYMARKET_PROVIDER="polymarket"  # Options: "mock" or "polymarket"
NEWS_PROVIDER="rss"               # Options: "mock" or "rss"
ALLOW_MOCK_FALLBACK=False         # Set False to avoid generating synthetic fallback data

# Sentiment Analysis Settings (100% Local Inference, No API Keys Required)
SENTIMENT_MODEL="ProsusAI/finbert" # HuggingFace financial model cached locally in ~/.cache/huggingface/
USE_FINBERT=True                   # Set True for local FinBERT neural classification, False for heuristic dictionary

# Scheduler
ENABLE_SCHEDULER=False
JOB_INTERVAL_MINUTES=60
